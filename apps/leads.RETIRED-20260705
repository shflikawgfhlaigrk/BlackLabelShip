# Black Label Leads — Developer-ID lane (values verified against repo 2026-07-01)
# Pure-Swift swiftc build, NO bundled runtime, universal2 (per-arch + lipo). Non-sandbox +
# hardened runtime; devid entitlements intentionally empty. In-app updater verifies Dev-ID
# in-process (Security.framework) — fail-closed on missing checksum/notarization.
repo = "~/BlackLabelLeads"
bundle_id = "com.blacklabel.leads"
app_name = "Black Label Leads.app"
build_cmd = "./build.command --devid"
built_app_path = "build/Black Label Leads.app"
arch = "universal2"
required_entitlements = []
forbidden_entitlements = ["com.apple.security.app-sandbox"]
ships_no_data_globs = ["*.sqlite", "*.sqlite3", "*.db", "*.csv", "*.pem", "*.key", "*.tokens", "*secrets*", "leads*", "*.env"]
r2_dl_key = "leads.zip"
r2_updates_key = "updates/leads/{build}.zip"
manifest_endpoint = "/api/version/leads"
dl_url = "https://blacklabelbots.com/dl/leads.zip?k=c76acb879e8fe0d8d69a9b081e01758d"
ports = []
test_cmd = "bash Tests/run-tests.command"
entitlements_file = "Sources/app-devid.entitlements"
